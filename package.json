  "private": true,
  "description": "KARMA Music Game — Türk müzik endüstrisi simülasyonu (statik site: index.html + js/ + css/)",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.15"
  },
  "scripts": {
    "verify": "node tools/verify.js",
    "test": "node tools/verify.js",
